+private fun bestStreak(records: List<DailyRecord>, rule: BrowserRule): Int {
+    var best = 0
+    var running = 0
+    records.forEach { record ->
+        if (record.hasData && !record.commitmentBroken && goalMet(record, rule)) {
+            running++
+            if (running > best) best = running
+        } else {
+            running = 0
+        }
+    }
+    return best
+}
